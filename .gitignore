# Dependencies
node_modules/

# Build output
dist/

# Environment files
.env
.env.local
.env.*.local

# Friend-watchlist sync: private links + service-account key
watchlist-sources.json
*.gserviceaccount.json

# IDE
.vscode/
.idea/
*.swp
*.swo
.cursor/
# .claude/ — selectively ignored. We commit project subagents (.claude/agents/*.md)
# but exclude user-specific settings and the local cache.
.claude/settings.local.json
.claude/cache/
.claude/skills/
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*

# Test coverage
coverage/

# Temporary files
tmp/
temp/
.scan-issues.json
.jules-last-issues.json
retro-*.txt

# Maestro AI
.agent/

# Scan results (stored daily) — exclude contents but not the directory itself, so the
# exception below can re-include monitor-list.json (parent-dir exclusions block re-include).
results/*
# Exception: monitor-list.json IS committed daily so follow-up state survives CI runs.
!results/monitor-list.json
# Exception: ticker-outcomes.json drives TD-21 (auto blacklist) + TD-23 (hot streak)
# at scan time. Refreshed weekly by .github/workflows/weekly-stats-refresh.yml.
!results/ticker-outcomes.json
# Exception: sector-outcomes.json drives TD-15 (dynamic sector blacklist).
# Same weekly refresh cadence as ticker-outcomes.
!results/sector-outcomes.json
# Exception: tv-state.json is committed by the tv-sync GHA workflow so
# telegram-mcp can read watchlist state without needing local disk access.
!results/tv-state.json
# Exception: oos_log.csv is the append-only frozen OOS scorecard for the Purple
# Fragility gauge — committed daily by the scan so the out-of-sample record
# survives CI runs (it is the ONLY frozen record; D1 gets recomputed).
!results/oos_log.csv
# Finnhub fundamentals cache (TTL 7d) — never committed, never shared across machines.
results/finnhub-cache/
.claude/worktrees/
.fuse_hidden*
# Generated code-graph output (graphify) — 2.7MB of graph.json/graph.html rebuilt
# on demand with `graphify update .` at no API cost. Build artifact, not source.
graphify-out/

# Infisical CLI project link (workspaceId + branch→environment mapping). Local
# tooling only — nothing in CI reads it; GitHub Actions secrets feed the
# workflows. Untracked on purpose so the repo does not carry a pointer into the
# shared secrets workspace.
.infisical.json
