{
  "name": "lean-dashboard",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "jest",
    "seed": "tsx scripts/seed.ts",
    "seed:local:sql": "node scripts/gen-seed-sql.mjs",
    "db:local:schema": "wrangler d1 execute lean-radar --local --persist-to=.wrangler/state --file=schema.sql",
    "db:local:seed": "wrangler d1 execute lean-radar --local --persist-to=.wrangler/state --file=seed.sql",
    "dev": "wrangler pages dev public --persist-to=.wrangler/state --compatibility-date=2025-07-18",
    "deploy": "wrangler pages deploy public"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240000.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "wrangler": "^3.60.0"
  }
}
