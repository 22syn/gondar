{
  // Type-check-only config. tsconfig.json is build-scoped (rootDir src → dist) and explicitly
  // excludes tests/, so on its own it never checks the 49 operational scripts under scripts/
  // nor the test suites — both were type-checked by nobody. This widens the net without
  // changing what `npm run build` emits.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*", "scripts/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
